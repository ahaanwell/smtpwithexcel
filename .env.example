# Copy to .env and fill in. Never commit .env.

PORT=5000

SMTP_USER=info@searchmyspace.in
# Wrap in single quotes if the password contains $ or #
SMTP_PASS='your-smtp-password'

# Google Sheets: either base64 of the full service-account JSON...
GOOGLE_CREDENTIALS_BASE64=
# ...or these two (used as fallback if the base64 key is invalid)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
